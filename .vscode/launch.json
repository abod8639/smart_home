{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "smart_home",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "smart_home (profile mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile"
    },
    {
      "name": "smart_home (release mode)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "name": "smart_home (Flutter Chrome)",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "chrome"
      ],
      "env": {
        "CHROME_EXECUTABLE": "/usr/bin/google-chrome-stable"
      }
    }
  ]
}